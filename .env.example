# ==========================================
# KidSynq Environment Configuration
# ==========================================

# Database Configuration (cPanel MySQL)
DB_CONNECTION=mysql
DB_ENGINE=django.db.backends.mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kidsynq
DB_USERNAME=root
DB_PASSWORD=root
# Or use full URL if supported:
# DATABASE_URL=mysql://dbuser:dbpass@127.0.0.1:3306/dbname

# Django Core Settings
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=False

# Host & Domain Configuration (Comma-separated)
ALLOWED_HOSTS=kidsynq.com,www.kidsynq.com,api.kidsynq.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://kidsynq.com,https://www.kidsynq.com,https://api.kidsynq.com
CORS_ALLOWED_ORIGINS=https://kidsynq.com,https://www.kidsynq.com,https://api.kidsynq.com

# Cookie Security (set to True when using HTTPS/SSL on GoDaddy)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Timezone
TIME_ZONE=UTC

# Logging
DJANGO_LOG_LEVEL=INFO

# Email Settings (GoDaddy cPanel / SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@kidsynq.com
